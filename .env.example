# Optional citation-constrained LLM generation. Retrieval works without a key.
GEMINI_API_KEY=
KERATOSCAN_GEMINI_MODEL=gemini-3.6-flash

# Optional embedding override. The service rebuilds an incompatible local index.
KERATOSCAN_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional checkpoint overrides; relative paths resolve from the project directory.
KERATOSCAN_CLINICAL_MODEL=models/catboost_final_pipeline.pkl
KERATOSCAN_IMAGE_MODEL=models/model1.pth
